{
  "name": "shieldpay",
  "version": "1.0.0",
  "private": true,
  "description": "ShieldPay — fintech-style demo API + React UI for DevSecOps / secure SDLC practice (lab baseline).",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "smoke": "node scripts/smoke-health.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "express-rate-limit": "^8.4.1",
    "lusca": "^1.7.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.1.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
