# ShieldPay — local demo only. Never deploy this baseline to production.
PORT=8788
# Bind address: use 0.0.0.0 inside Docker; default 127.0.0.1 for local Node.
# LISTEN_HOST=127.0.0.1
DATABASE_PATH=./backend/data/shieldpay.db

# Admin seed user (created on first DB init if missing)
ADMIN_EMAIL=admin@shieldpay.lab
ADMIN_PASSWORD=ChangeMeAdmin123!

# JWT: MUST be a long, random secret in any real deployment.
# The application ships a weak fallback when unset so automated tools can flag it (lab only).
JWT_SECRET=

# Session cookie secret (use a strong random value outside the lab)
SESSION_SECRET=change-me-session
